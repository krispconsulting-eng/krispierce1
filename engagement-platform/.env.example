# Contact form backend — choose ONE provider before deploying.

# Option A (preferred): Resend via Vercel serverless function at /api/contact
# Set these in the Vercel project (Server, not VITE_*):
#   RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
#   CONTACT_TO_EMAIL=hello@krispierce.com.au
#   CONTACT_FROM_EMAIL=engage@krispierce.com.au

# Option B: Formspree (no backend, drop-in for static hosts)
# VITE_FORMSPREE_ID=xxxxxxxxxxxx

# Analytics (optional, confirm preference with Kris)
# VITE_PLAUSIBLE_DOMAIN=krispierce.com.au
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
